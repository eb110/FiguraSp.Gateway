{
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
    //"RateLimitOptions": {
    //  "RouteKeys": [], // if undefined or empty array, opts will apply to all routes
    //  "Limit": 1,
    //  "Period": "30s", // ms, s, m, h, d
    //  "Wait": "1m", // ms, s, m, h, d
    //  "StatusCode": 429, // Too Many Requests -> standard status
    //  "QuotaMessage": "Ocelot API calls quota exceeded! Maximum admitted {0} per {1}.", // standard template with 2 parameters
    //  "KeyPrefix": "ocelot-rate-limiting" // for caching key
    //}
  },


  "Routes": [
    //Downstream - what ocelot can access
    //Upstream - what user can access

    //you can specify individual endpoint with individual http method

    //rate limit option
    //if its going to be a free access like riders stats check
    //this should be off
    //if rider creation / login / register
    //this should be on

    //file cache option
    //if riders list to check
    //caching should be on
    //if login / register / add
    //caching should be off
    //caching can attach a header

    //authentication
    //option to put specific config value for certain authentication
    //it is needed in case the endpoint is restricted by authorization



    //USER 5001 api/user (POST)
    {
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/api/user/{everything}",
      "UpstreamHttpMethod": [ "POST" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "Limit": 2,
        "Period": "1m", // (milli)seconds, minutes, hours, days
        "Wait": "20s", // (milli)seconds, minutes, hours, days
        "StatusCode": 418, // I'm a teapot -> this is special status
        "QuotaMessage": "Out of coffee!"
      }
    },

    //USER 5001 api/user (GET)
    {
      "DownstreamPathTemplate": "/api/user/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/api/user/{everything}",
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ],
        "AllowedScopes": []
      },
      "UpstreamHttpMethod": [ "GET" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "Limit": 5,
        "EnableRateLimiting": true,
        "Period": "1m",
        "HttpStatusCode": 429,
        "PeriodTimespan": 20,
        "QuotaExceededMessage": "no kurwa",
        "QuotaMessage": "wpierdol"
      }
    },

    //RIDER 5002 api/rider
    {
      "DownstreamPathTemplate": "/api/rider/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],

      //Specific endpoint
      "UpstreamPathTemplate": "/api/rider/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        //clients exclude -> by id
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        //if there will be more than limit calls within period
        //the quota message is going to be sent back
        "Limit": 1
        //how long to wait before give new access in case of limit overflow
        //"PeriodTimespan": 10
      }
    }
  ]
}
